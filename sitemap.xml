---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<!--
	Built with Liquid instead of jekyll-sitemap so the site keeps its two
	dependencies and still builds natively on GitHub Pages.

	No <lastmod>: every page would report the build time, which is not when the
	page changed, and a sitemap that lies about freshness is worse than one that
	says nothing. Set `sitemap: false` in a page's front matter to leave it out.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{% for page in site.html_pages %}{% unless page.sitemap == false or page.url contains '404' %}
	<url><loc>{{ page.url | absolute_url }}</loc></url>{% endunless %}{% endfor %}
</urlset>
